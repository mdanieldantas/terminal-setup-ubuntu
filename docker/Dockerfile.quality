# syntax=docker/dockerfile:1
# ==============================================================================
# docker/Dockerfile.quality — Ambiente isolado de qualidade estatica e Bats-core
# Projeto: terminal-setup (Ubuntu 24.04 LTS amd64)
#
# Papel:
#   - Imagem dedicada exclusivamente a execucao de ShellCheck, shfmt e Bats-core,
#     separada da imagem de uso normal do usuario (docker/Dockerfile).
#   - Nao instala ferramentas no host Aurora/Fedora e nao polui a imagem de
#     trabalho do usuario com dependencias de linter/teste.
# ==============================================================================

FROM ubuntu:24.04

ARG USERNAME=qa
ARG USER_UID=1000
ARG USER_GID=1000

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# Instalar ferramentas de analise estatica, formatacao e testes do Ubuntu 24.04 (noble):
#   - shellcheck (0.9.0-1, universe)
#   - shfmt      (3.8.0-1, universe)
#   - bats       (1.10.0-1, universe)
#   - zsh, git, jq, curl, ca-certificates (para validacao zsh -n e suites unitarias)
RUN set -eux; \
    apt-get update -y; \
    apt-get install -y --no-install-recommends \
      bats \
      ca-certificates \
      curl \
      git \
      jq \
      shellcheck \
      shfmt \
      zsh; \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*.deb /var/cache/apt/archives/partial/*.deb; \
    if getent group "${USERNAME}" >/dev/null 2>&1; then \
      true; \
    elif ! getent group "${USER_GID}" >/dev/null 2>&1; then \
      groupadd --gid "${USER_GID}" "${USERNAME}"; \
    else \
      groupadd "${USERNAME}"; \
    fi; \
    if id -u "${USERNAME}" >/dev/null 2>&1; then \
      usermod --home "/home/${USERNAME}" --shell /bin/bash "${USERNAME}"; \
    elif ! getent passwd "${USER_UID}" >/dev/null 2>&1; then \
      useradd --uid "${USER_UID}" --gid "${USERNAME}" --create-home --home-dir "/home/${USERNAME}" --shell /bin/bash "${USERNAME}"; \
    else \
      useradd --gid "${USERNAME}" --create-home --home-dir "/home/${USERNAME}" --shell /bin/bash "${USERNAME}"; \
    fi; \
    passwd -l "${USERNAME}" >/dev/null 2>&1 || usermod -L "${USERNAME}" >/dev/null 2>&1 || true; \
    mkdir -p /workspace "/home/${USERNAME}"; \
    chown -R "${USERNAME}:${USERNAME}" /workspace "/home/${USERNAME}"

COPY --chown=${USERNAME}:${USERNAME} . /workspace

USER ${USERNAME}
WORKDIR /workspace

ENV HOME=/home/${USERNAME} \
    USER=${USERNAME}

CMD ["bash"]

